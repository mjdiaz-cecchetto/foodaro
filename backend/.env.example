APP_NAME=Foodaro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (XAMPP por defecto: usuario root sin contraseña)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodaro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Orígenes permitidos para el frontend Angular (separados por coma)
CORS_ORIGENES=http://localhost:4200

# Credenciales del administrador del local demo (seeder)
DEMO_ADMIN_EMAIL=admin@demolocal.com
DEMO_ADMIN_PASSWORD=demo1234
